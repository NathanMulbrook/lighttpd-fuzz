# Portable I/O paths and permissive request parsing.
server.event-handler = "poll"
server.network-backend = "writev"
server.http-parseopts += (
    "header-strict" => "disable",
    "host-strict" => "disable",
    "host-normalize" => "disable",
    "method-get-body" => "enable",
)

server.modules += (
    "mod_setenv",
    "mod_access",
    "mod_alias",
    "mod_redirect",
    "mod_rewrite",
    "mod_status",
    "mod_accesslog",
)

accesslog.filename = "@RUN_DIR@/access.log"
status.status-url = "/server-status"
alias.url = ( "/alias/" => "@RUN_DIR@/www/files/" )
url.redirect = ( "^/redirect$" => "/" )
url.rewrite-if-not-file = ( "^/rewrite/(.*)$" => "/$1" )
setenv.add-request-header = ( "X-Fuzz-Config" => "2" )
