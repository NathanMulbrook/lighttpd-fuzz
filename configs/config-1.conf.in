# Broad, common production features: routing conditions, auth, status,
# compression, expiration, forwarded headers, and access logging.
server.modules += (
    "mod_extforward",
    "mod_auth",
    "mod_authn_file",
    "mod_setenv",
    "mod_access",
    "mod_expire",
    "mod_status",
    "mod_deflate",
    "mod_accesslog",
)

accesslog.filename = "@RUN_DIR@/access.log"
status.status-url = "/server-status"
status.config-url = "/server-config"
deflate.mimetypes = ( "text/plain", "text/html", "application/json" )
deflate.allowed-encodings = ( "gzip", "deflate" )
expire.url = ( "/files/" => "access plus 1 hours" )
extforward.headers = ( "Forwarded", "X-Forwarded-For" )
extforward.forwarder = ( "127.0.0.1" => "trust" )
setenv.add-response-header = ( "X-Fuzz-Config" => "1" )

auth.backend = "plain"
auth.backend.plain.userfile = "@RUN_DIR@/config/users"
auth.require = (
    "/private/" => (
        "method" => "basic",
        "realm" => "lighttpd-fuzz",
        "require" => "valid-user",
    ),
)
