# HTTP/2 frontend to a controlled HTTP/1 backend with header remapping.
server.event-handler = "epoll"
server.network-backend = "sendfile"
server.stream-request-body = 2
server.stream-response-body = 2
server.feature-flags += ( "server.h2proto" => "enable", "server.h2c" => "enable" )
server.modules += ( "mod_proxy", "mod_fastcgi", "mod_scgi", "mod_accesslog" )
accesslog.filename = "@RUN_DIR@/access.log"

fastcgi.server = ( "/h2-fastcgi/" => (
    "fixture" => (
        "host" => "127.0.0.1",
        "port" => 6502,
        "check-local" => "disable",
    ),
) )

scgi.server = ( "/h2-scgi/" => (
    "fixture" => (
        "host" => "127.0.0.1",
        "port" => 6503,
        "check-local" => "disable",
    ),
) )

$HTTP["url"] =~ "^/h2-proxy/" {
    proxy.server = ( "" => (
        "fixture" => ( "host" => "127.0.0.1", "port" => 6501 ),
    ) )
    proxy.forwarded = ( "for" => "enable", "host" => "enable", "proto" => "enable" )
    proxy.header = ( "map-urlpath" => ( "/h2-proxy/" => "/" ) )
}
