# Digest authentication, authorization expressions, and credential caching.
server.event-handler = "poll"
server.network-backend = "writev"
server.feature-flags += ( "auth.delay-invalid-creds" => "disable" )
server.modules += ( "mod_auth", "mod_authn_file", "mod_accesslog" )
accesslog.filename = "@RUN_DIR@/access.log"
auth.backend = "plain"
auth.backend.plain.userfile = "@RUN_DIR@/config/users"
auth.cache = ( "max-age" => 60 )
auth.require = (
    "/digest/" => (
        "method" => "digest",
        "realm" => "lighttpd-fuzz-digest",
        "require" => "valid-user",
        "algorithm" => "MD5|MD5-sess",
        "nonce-secret" => "fixed-fuzzing-nonce-secret",
    ),
    "/basic-user/" => (
        "method" => "basic",
        "realm" => "lighttpd-fuzz-basic",
        "require" => "user=fuzz",
    ),
)
