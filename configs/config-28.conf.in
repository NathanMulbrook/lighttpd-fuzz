# Sorted uncached directory listings with hidden files and alternate layout.
server.event-handler = "epoll"
server.network-backend = "sendfile"
dir-listing.activate = "enable"
dir-listing.exclude = ( "\\.tmp$", "\\.secret$" )
dir-listing.hide-dotfiles = "enable"
dir-listing.show-readme = "README.txt"
dir-listing.show-header = "HEADER.txt"
dir-listing.hide-readme-file = "disable"
dir-listing.hide-header-file = "disable"
dir-listing.encode-readme = "disable"
dir-listing.encode-header = "disable"
dir-listing.auto-layout = "disable"
dir-listing.sort = "enable"
server.modules += ( "mod_accesslog" )
accesslog.filename = "@RUN_DIR@/access.log"
